# Copy to .env.local (Next.js loads it automatically).

# --- Local API (recommended): avoids /backend-api proxy; fixes many "500 on bootstrap" dev issues ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# If you omit NEXT_PUBLIC_API_URL, dev uses Next rewrite: /backend-api/* → http://127.0.0.1:4000/api/*
# That only works while `cd backend && npm run dev` is running on port 4000.

# --- Production (Vercel) ---
# NEXT_PUBLIC_API_URL=https://your-service.onrender.com

# Optional SaaS CTAs (fallback if subscription URLs are empty):
# NEXT_PUBLIC_CONTACT_US_URL=mailto:support@yourdomain.com?subject=Support
# NEXT_PUBLIC_SUPPORT_PHONE=+919876543210
# NEXT_PUBLIC_UPGRADE_URL=https://yourdomain.com/pricing

# Public app URL (WhatsApp links, QR, invoices). Also used as first FRONTEND_ORIGIN entry on backend for password-reset links.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public marketing website — staff login/signup/logout redirect here (not the workshop /login UI).
# NEXT_PUBLIC_MARKETING_SITE_URL=http://localhost:3003
# Production: NEXT_PUBLIC_MARKETING_SITE_URL=https://www.mydetailos.com
